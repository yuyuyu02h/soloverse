PORT=3001
# 必須: 本番では必ず強力なランダム文字列に変更
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# LLM: 1つ以上のAPIキーを設定（ローカルLLMは使用しません）
# 既定のフォールバック順: Groq → Gemini → OpenRouter
LLM_PROVIDER_ORDER=groq,gemini,openrouter

# 第1候補: Groq Free
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# 第2候補: Gemini Free Tier
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite

# 最終候補: OpenRouter Free Models Router
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/free

# 1リクエストとフォールバック全体のタイムアウト（ミリ秒）
LLM_REQUEST_TIMEOUT_MS=45000
LLM_TOTAL_TIMEOUT_MS=120000
# 429応答にRetry-Afterが無い場合のクールダウン
LLM_RATE_LIMIT_COOLDOWN_MS=60000
LLM_INVALID_OUTPUT_COOLDOWN_MS=300000

# 無料枠を節約する場合は60等に増やす（最小5分）
AUTONOMOUS_INTERVAL_MINUTES=15
WORLD_TIME_ZONE=Asia/Tokyo
# 質問・呼びかけへの最初の返信を何分以内に予約するか（1〜10）
AI_DIRECT_REPLY_MAX_DELAY_MINUTES=3

# 任意: 全プロバイダー共通の呼び出し間隔。未設定時は各社向け安全値を使用
# LLM_REQUEST_INTERVAL_MS=3500
# GROQ_REQUEST_INTERVAL_MS=2500
# GEMINI_REQUEST_INTERVAL_MS=6500
# OPENROUTER_REQUEST_INTERVAL_MS=3500

# フロントエンドのURL（本番では実際のドメインに変更）
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# 任意: SQLiteファイルの保存先（未指定時: backend/soloverse.db）
# DB_PATH=./data/soloverse.db

# 任意: APIサーバーと定期ジョブを分離する場合のみ false
BACKGROUND_JOBS=true
# リバースプロキシ配下で正しいクライアントIPを使う場合のみ true
TRUST_PROXY=false

# New generation pipeline. Set legacy to restore the original generator without deleting data.
CONTENT_PIPELINE=enhanced
# Application-side daily UTC budgets shared by all users; not provider quota guarantees.
LLM_DAILY_REQUEST_BUDGET=180
LLM_DAILY_TOKEN_BUDGET=150000
LLM_REPLY_RESERVE_PERCENT=40
# Generate candidates for 12 hours; publish them gradually. Refill only missing items.
CONTENT_POOL_SIZE=24
CONTENT_POOL_HOURS=12
CONTENT_REFILL_ATTEMPTS=2
# At most two low-pool ambient templates per world per rolling 24 hours.
CONTENT_TEMPLATES=true
